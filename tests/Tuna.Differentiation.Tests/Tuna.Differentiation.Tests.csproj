<Project Sdk="Microsoft.NET.Sdk">

  <!-- 逆モード自動微分 Tuna.Differentiation のテスト。コアのテストはこの拡張を参照しない。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="CsCheck" Version="5.0.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tuna.Differentiation\Tuna.Differentiation.csproj" />
    <ProjectReference Include="..\..\src\Tuna.Generators\Tuna.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ReferenceData\ScalarFunctionReferences.Generated.cs" Link="ReferenceData\ScalarFunctionReferences.Generated.cs" />
    <Compile Include="..\ReferenceData\ScalarFunctionReferenceAssert.cs" Link="ReferenceData\ScalarFunctionReferenceAssert.cs" />
    <Compile Include="..\ReferenceData\ReferencePrecision.cs" Link="ReferenceData\ReferencePrecision.cs" />
  </ItemGroup>

</Project>

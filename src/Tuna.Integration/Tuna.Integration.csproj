<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tuna.Integration</RootNamespace>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Description>One-dimensional, multidimensional adaptive, and quasi-Monte Carlo numerical integration for Tuna.</Description>
    <PackageTags>numerics;integration;quadrature;cubature;quasi-monte-carlo;tuna;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tuna\Tuna.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ライブラリ全体の MIT 本文はリポジトリ直下に置き、パッケージの直下に格納する -->
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>

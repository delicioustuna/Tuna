<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tuna.Optimization</RootNamespace>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Description>Numerical optimization algorithms (L-BFGS, SGD/Adam, proximal methods, global interval optimization, and evolutionary algorithms) for Tuna.</Description>
    <PackageTags>numerics;optimization;lbfgs;adam;proximal;evolutionary;tuna;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tuna\Tuna.csproj" />
    <ProjectReference Include="..\Tuna.Differentiation\Tuna.Differentiation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ライブラリ全体の MIT 本文はリポジトリ直下に置き、パッケージの直下に格納する -->
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
